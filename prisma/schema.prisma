generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  STUDENT
  DIRECTOR
  ACCOUNTING
  SYSTEM_ADMIN
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  RETURNED
  RESUBMITTED
  APPROVED
  UPLOADED
  TRANSMITTED
  ARCHIVED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(STAFF)
  active        Boolean        @default(true)
  departmentId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Persisted Student Profile (independent of applications)
  studentProfile         Json?          @default("{}")

  // Microsoft Authenticator & 2FA Extensions
  twoFactorEnabled       Boolean        @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[]       @default([])
  twoFactorType          String?        @default("MICROSOFT_AUTHENTICATOR")
  authenticatorLocked    Boolean        @default(false)

  sessions      Session[]
  documents     Document[]
  comments      Comment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  applications  Application[]
  applicantCalls ApplicantCall[]
  transmittals  Transmittal[]
  verificationRuns VerificationRun[]
  announcements    Announcement[]
  notifyAnnouncements Boolean       @default(true)
  notifyPush          Boolean       @default(false)

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("sessions")
}

model AnnexType {
  id           String      @id @default(cuid())
  number       Int         @unique
  name         String
  creatorRoles Role[]
  formSchema   Json
  pdfTemplate  String?
  documents    Document[]

  @@map("annex_types")
}

model Document {
  id            String          @id @default(cuid())
  annexTypeId   String
  annexType     AnnexType       @relation(fields: [annexTypeId], references: [id])
  title         String
  status        DocumentStatus  @default(DRAFT)
  formData      Json            @default("{}")
  fileUrl       String?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  departmentId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  comments      Comment[]
  statusHistory StatusHistory[]
  transmittal   Transmittal?

  @@index([status])
  @@index([createdById])
  @@index([annexTypeId])
  @@map("documents")
}

model StatusHistory {
  id         String         @id @default(cuid())
  documentId String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fromStatus DocumentStatus
  toStatus   DocumentStatus
  actorId    String
  comment    String?
  createdAt  DateTime       @default(now())

  @@index([documentId])
  @@map("status_history")
}

model Comment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@map("comments")
}

model Transmittal {
  id         String   @id @default(cuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sentById   String
  sentBy     User     @relation(fields: [sentById], references: [id])
  method     String   // "email", "drive_link", "manual"
  recipient  String
  driveLink  String?
  notes      String?
  sentAt     DateTime @default(now())

  @@map("transmittals")
}

model ApplicantCall {
  id           String        @id @default(cuid())
  title        String
  description  String?
  batchNumber  Int           @default(1)
  startDate    DateTime      @default(now())
  deadline     DateTime
  formSchema   Json
  isActive     Boolean       @default(true)
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications Application[]

  @@index([isActive])
  @@index([batchNumber])
  @@index([startDate, deadline])
  @@map("applicant_calls")
}

model Application {
  id               String            @id @default(cuid())
  callId           String?
  call             ApplicantCall?    @relation(fields: [callId], references: [id], onDelete: Cascade)
  studentId        String
  student          User              @relation(fields: [studentId], references: [id])
  batchNumber      Int               @default(1)
  formData         Json
  trackingCode     String            @unique
  status           ApplicationStatus @default(SUBMITTED)
  reviewComment    String?
  reviewedById     String?
  reviewedAt       DateTime?
  annex1DocumentId String?
  submittedAt      DateTime          @default(now())

  @@index([studentId])
  @@index([callId])
  @@index([status])
  @@index([batchNumber])
  @@map("applications")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_log")
}

model LandingPageConfig {
  id                    String    @id @default("default")
  publishedSections     Json
  draftSections         Json
  hasUnpublishedChanges Boolean   @default(false)
  publishedAt           DateTime?
  updatedAt             DateTime  @updatedAt
  updatedById           String?

  @@map("landing_page_config")
}

model VerificationRun {
  id                      String               @id @default(cuid())
  runNumber               Int                  @default(autoincrement())
  title                   String
  chedFileName            String
  registrarFileName       String
  systemDataSource        String               @default("ACCEPTED_GRANTEES") // "ACCEPTED_GRANTEES" | "ALL_APPLICANTS"
  totalChedRows           Int                  @default(0)
  totalRegistrarRows      Int                  @default(0)
  totalSystemRows         Int                  @default(0)
  fullyVerifiedCount      Int                  @default(0)
  needsEncodingCount      Int                  @default(0)
  notEnrolledCount        Int                  @default(0)
  systemDiscrepancyCount  Int                  @default(0)
  possibleMatchCount      Int                  @default(0)
  enrolledNonScholarCount Int                  @default(0)
  createdById             String
  createdBy               User                 @relation(fields: [createdById], references: [id])
  createdAt               DateTime             @default(now())

  results                 VerificationResult[]

  @@index([createdById])
  @@index([createdAt])
  @@map("verification_runs")
}

model VerificationResult {
  id                 String          @id @default(cuid())
  runId              String
  run                VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  status             String          // "FULLY_VERIFIED" | "NEEDS_ENCODING" | "NOT_ENROLLED" | "SYSTEM_DISCREPANCY" | "POSSIBLE_MATCH" | "ENROLLED_NON_SCHOLAR"
  studentIdNo        String?         // Registrar ID Number or System Student ID
  lastName           String
  firstName          String
  middleName         String?
  school             String
  inChed             Boolean         @default(false)
  inRegistrar        Boolean         @default(false)
  inSystem           Boolean         @default(false)
  confidenceScore    Float?          // e.g. 0.92 for 92% fuzzy match
  matchDetails       Json?           // { candidateName: string, candidateId: string, matchedFields: string[] }
  isManuallyResolved Boolean         @default(false)
  resolvedStatus     String?
  resolvedNotes      String?
  createdAt          DateTime        @default(now())

  @@index([runId])
  @@index([status])
  @@index([lastName, firstName])
  @@map("verification_results")
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  content        String
  category       String   @default("GENERAL") // GENERAL | URGENT | DEADLINE | REQUIREMENTS | PAYROLL
  isPinned       Boolean  @default(false)
  targetAudience String   @default("ALL")     // ALL | STUDENTS | PUBLIC
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPinned, createdAt])
  @@index([category])
  @@index([authorId])
  @@map("announcements")
}

