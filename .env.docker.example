# =====================================================================
# MinSU DocTrack - Docker Environment Configuration
# Copy this file to .env before running docker compose if you wish to
# customize credentials, ports, or application settings.
# =====================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=5mdb02f6
POSTGRES_DB=db_TDP
POSTGRES_PORT=5432

# Application Database Connection (Inter-container DNS uses service name 'db')
DATABASE_URL=postgresql://postgres:5mdb02f6@db:5432/db_TDP?schema=public

# Application Secrets & Metadata
SESSION_SECRET=minsu_doctrack_secure_session_secret_2026
NEXT_PUBLIC_APP_NAME=MinSU DocTrack
APP_PORT=3000

# Seeding Control
# Set FORCE_SEED=true if you wish to wipe and re-seed the database on container start
FORCE_SEED=false
