# =====================================================================
# MinSU DocTrack - Docker Environment Configuration
# Copy this file to .env before running docker compose if you wish to
# customize credentials, ports, or application settings.
# =====================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=db_TDP
POSTGRES_PORT=5432

# Application Database Connection (Inter-container DNS uses service name 'db')
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@db:5432/db_TDP?schema=public

# Application Secrets & Metadata (generate SESSION_SECRET with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_HEX_CHARS_WITH_OPENSSL_RAND
NEXT_PUBLIC_APP_NAME=MinSU DocTrack
APP_PORT=3000

# Hybrid Deployment Security Controls
# TRUST_PROXY=true when deployed behind Nginx / Cloudflare / Caddy TLS termination
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
# ENABLE_HSTS=true only when served strictly over HTTPS
ENABLE_HSTS=false
# COOKIE_SECURE=false only if serving plain HTTP on an internal campus LAN (defaults to secure in production)
COOKIE_SECURE=

# Seeding Control
# Set ALLOW_DEMO_SEED=true only in local dev/staging to allow prisma/seed.ts on startup
ALLOW_DEMO_SEED=false
FORCE_SEED=false
