# =====================================================================
# MinSU DocTrack - Docker Environment Configuration Template
# Copy this file to .env.docker before running docker compose if you
# wish to customize credentials or secrets.
# =====================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=minsu_doctrack_secret
POSTGRES_DB=db_TDP
POSTGRES_PORT=5432

# Application Database Connection (Inter-container DNS: 'db')
DATABASE_URL=postgresql://postgres:minsu_doctrack_secret@db:5432/db_TDP?schema=public

# Application Secrets & Metadata
SESSION_SECRET=minsu_doctrack_docker_session_secret_2026
NEXT_PUBLIC_APP_NAME=MinSU DocTrack
APP_PORT=3000
